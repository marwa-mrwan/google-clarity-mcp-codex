GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Optional: only needed for Google Ads tools.
GOOGLE_ADS_DEVELOPER_TOKEN=your_google_ads_developer_token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=your_manager_customer_id_without_dashes

# Optional fallback if you do not use `npm run auth`.
GOOGLE_REFRESH_TOKEN=your_google_refresh_token

# Optional: override where OAuth tokens are saved.
GOOGLE_TOKEN_FILE=../.vscode/google.tokens.local.json
