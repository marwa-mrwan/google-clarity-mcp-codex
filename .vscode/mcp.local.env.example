# Copy this file to .vscode/mcp.local.env on each machine.
# Do not commit the copied local file.

# Google OAuth app credentials.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Optional: only needed for Google Ads tools.
GOOGLE_ADS_DEVELOPER_TOKEN=your_google_ads_developer_token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=your_manager_customer_id_without_dashes

# Optional fallback if you do not use `npm run auth`.
GOOGLE_REFRESH_TOKEN=your_google_refresh_token

# Used by `npm run auth` when run from google-mcp.
GOOGLE_TOKEN_FILE=../.vscode/google.tokens.local.json

# Mangools API.
MANGOOLS_API_KEY=your_mangools_api_key

# Optional multi-project Clarity config as base64-encoded JSON.
# Example source JSON: {"projects":[{"name":"site","label":"Site","token":"token"}]}
CLARITY_PROJECTS_JSON_BASE64=base64_encoded_projects_json

# Optional single-project Clarity fallback.
CLARITY_API_TOKEN=your_clarity_data_export_token
CLARITY_PROJECT_NAME=default
CLARITY_PROJECT_LABEL=Default Clarity Project
