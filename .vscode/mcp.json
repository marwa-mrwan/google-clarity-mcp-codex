{
  "servers": {
    "google-marketing-suite": {
      "type": "stdio",
      "command": "node",
      "args": ["${workspaceFolder}/google-mcp/index.js"],
      "envFile": "${workspaceFolder}/.vscode/mcp.local.env",
      "env": {
        "GOOGLE_TOKEN_FILE": "${workspaceFolder}/.vscode/google.tokens.local.json"
      }
    },
    "microsoft-clarity": {
      "type": "stdio",
      "command": "node",
      "args": ["${workspaceFolder}/clarity-mcp/index.js"],
      "envFile": "${workspaceFolder}/.vscode/mcp.local.env"
    },
    "mangools": {
      "type": "stdio",
      "command": "node",
      "args": ["${workspaceFolder}/mangools-mcp/index.js"],
      "envFile": "${workspaceFolder}/.vscode/mcp.local.env"
    }
  },
  "inputs": []
}
